{
  "name": "emergency-delivery-online",
  "version": "2.15.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node server.js"
  },
  "build": {
    "appId": "com.emergencydelivery.app",
    "productName": "Emergency Delivery",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist{,/**}",
      "!node_modules/.cache{,/**}"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Emergency-Delivery-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Emergency Delivery",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "icon": "assets/emergency-delivery.ico",
    "asar": true
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "web-push": "^3.6.7",
    "pdfkit": "^0.15.0",
    "nodemailer": "^6.9.16",
    "@electric-sql/pglite": "^0.3.14"
  },
  "description": "Emergency Delivery online server for blitz.cloud",
  "author": "Emergency Delivery"
}
