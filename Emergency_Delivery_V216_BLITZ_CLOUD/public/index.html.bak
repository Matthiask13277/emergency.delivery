 <label>Hersteller<input id="vhMake" value="${esc(v.make||"")}"></label><label>Modell<input id="vhModel" value="${esc(v.model||"")}"></label>
 <label>VIN<input id="vhVin" value="${esc(v.vin||"")}"></label><label>Baujahr<input id="vhYear" type="number" value="${esc(v.year||"")}"></label>
 <label>KM-Stand<input id="vhOdo" type="number" min="0" value="${esc(v.odometer_km||0)}"></label>
 <label>Status<select id="vhActive"><option value="true" ${v.active!==false?"selected":""}>Aktiv</option><option value="false" ${v.active===false?"selected":""}>Inaktiv</option></select></label>
 </div><div class="modal-actions"><button class="btn secondary" onclick="closeModal()">Abbrechen</button><button class="btn primary" onclick="saveVehicle('${id||""}')">Speichern</button></div>`);
