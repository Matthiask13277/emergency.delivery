 const body={name:document.getElementById("vhName").value.trim(),plate:document.getElementById("vhPlate").value.trim(),make:document.getElementById("vhMake").value.trim(),model:document.getElementById("vhModel").value.trim(),vin:document.getElementById("vhVin").value.trim(),year:document.getElementById("vhYear").value||null,odometer_km:Number(document.getElementById("vhOdo").value||0),active:document.getElementById("vhActive").value==="true"};
 if(!body.name||!body.plate)return alert("Name und Kennzeichen sind erforderlich.");
