<!doctype html><html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#172033"><link rel="manifest" href="/manifest.json"><title>Emergency Delivery</title><style>
html,body{margin:0;padding:0;width:100%;min-height:100%;overflow-x:hidden}body{font:14px Arial;background:#f4f6f8;color:#172033}.app-shell{display:flex;min-height:100vh}.sidebar{width:250px;background:#111827;color:#fff;position:fixed;left:0;top:0;bottom:0;padding:18px 14px;box-sizing:border-box;overflow:auto}.side-brand{font-size:22px;font-weight:800;padding:8px 10px 4px}.side-sub{font-size:11px;color:#9ca3af;padding:0 10px 18px}.menu-group{margin:16px 0}.menu-title{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#9ca3af;padding:0 10px 7px}.menu-btn{width:100%;border:0;background:transparent;color:#d1d5db;text-align:left;padding:10px;border-radius:8px;cursor:pointer;font-size:14px}.menu-btn:hover,.menu-btn.active{background:#1f2937;color:#fff}.menu-btn .ico{display:inline-block;width:24px;color:#9ca3af}.side-bottom{border-top:1px solid #374151;margin-top:18px;padding-top:14px}.main{margin-left:250px;width:auto;min-width:0;max-width:none;overflow-x:hidden;box-sizing:border-box}.wrap{width:auto;max-width:none;margin:0;padding:20px 24px;box-sizing:border-box}.topbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px}.brand{font-size:28px;font-weight:800}header{display:flex;justify-content:space-between;align-items:center}.nav{display:none}.btn{border:0;border-radius:8px;padding:9px 12px;background:#172033;color:#fff;cursor:pointer}.secondary{background:#fff;color:#172033;border:1px solid #d7dce5}.panel{background:#fff;border:1px solid #e0e4eb;border-radius:12px;padding:16px;margin-bottom:14px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.stat{background:#f8f9fb;padding:14px;border-radius:9px}.stat b{display:block;font-size:24px;margin-top:5px}.form{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}input,select{padding:10px;border:1px solid #d7dce5;border-radius:8px;width:100%;box-sizing:border-box}table{width:100%;border-collapse:collapse}th,td{padding:9px;border-bottom:1px solid #e6e8ec;text-align:left}.muted{color:#667085}.login{max-width:380px;margin:80px auto}.sig{border:1px solid #ccd2dc;border-radius:8px;width:100%;height:180px;background:#fff}.row{display:flex;gap:8px;flex-wrap:wrap}.live{height:340px;border:1px solid #d7dce5;border-radius:10px;padding:12px;overflow:auto;background:#fbfcfd}.vehicle{padding:10px;border-bottom:1px solid #e6e8ec}.dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:#172033;margin-right:6px}.section-anchor{scroll-margin-top:20px}@media(max-width:900px){.sidebar{width:210px}.main{margin-left:210px;width:auto}.grid,.form{grid-template-columns:1fr 1fr}}@media(max-width:600px){.sidebar{position:relative;width:100%;min-height:auto}.app-shell{display:block}.main{margin-left:0;width:100%}.grid,.form{grid-template-columns:1fr}.menu-group{display:inline-block;vertical-align:top;width:48%}.side-bottom{display:none}}body>section{display:none!important}body>iframe{display:none!important}#root{min-height:100vh} .main{min-width:0;overflow-x:hidden}.wrap{width:100%;box-sizing:border-box}</style><style>
.dashboard-map-empty{min-height:140px!important;height:auto!important;display:flex;align-items:center;justify-content:center;border:1px solid #dce3ec;border-radius:14px;background:#f8fafc;color:#64748b;padding:24px;box-sizing:border-box}
.dashboard-map-empty .empty-inner{text-align:center;max-width:520px}
.dashboard-map-empty .empty-icon{font-size:28px;margin-bottom:8px}
.dashboard-map-empty h3{margin:0 0 6px;color:#172033}
.dashboard-map-empty p{margin:0;line-height:1.5}
</style>
<style id="v178-ui">
:root{--ed-orange:#f97316;--ed-orange-dark:#ea580c;--ed-ink:#172033;--ed-muted:#667085;--ed-border:#e4e7ec;--ed-bg:#f6f8fb}
body{background:var(--ed-bg);font-family:Inter,Segoe UI,Arial,sans-serif}
.sidebar{background:#101827;width:238px;padding:20px 12px}
.side-brand{font-size:24px;line-height:1.05}
.side-sub{line-height:1.35}
.menu-group{margin:18px 0}
.menu-btn{transition:background .15s,transform .15s}
.menu-btn:hover{background:#1d2939;transform:translateX(1px)}
.menu-btn.active{background:var(--ed-orange);color:#fff}
.menu-btn.active .ico{color:#fff}
.main{margin-left:238px;background:var(--ed-bg)}
.wrap{padding:24px 28px 40px}
.topbar{padding:2px 0 18px;border-bottom:1px solid var(--ed-border);margin-bottom:20px}
.brand{font-size:26px;letter-spacing:-.02em}
.panel{border:1px solid var(--ed-border);border-radius:14px;padding:20px;background:#fff;box-shadow:0 1px 2px rgba(16,24,40,.03);margin-bottom:16px}
.grid{gap:14px}
.stat{background:#fff;border:1px solid var(--ed-border);border-radius:14px;padding:18px}
.stat b{font-size:28px;color:var(--ed-ink)}
.btn{border-radius:9px;background:var(--ed-orange);padding:10px 14px;font-weight:600}
.btn:hover{background:var(--ed-orange-dark)}
.btn.secondary{background:#fff;border:1px solid var(--ed-border)}
.page-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:16px}
.page-head h2{margin:3px 0 5px;font-size:24px}
.eyebrow{font-size:10px;font-weight:700;letter-spacing:.14em;color:var(--ed-orange)}
.employee-panel{min-height:180px}
.listRow{border-bottom:1px solid var(--ed-border);display:flex;align-items:center;gap:16px}
.listRow:last-child{border-bottom:0}
input,select{border:1px solid #d0d5dd;background:#fff}
table th{font-size:12px;color:#667085;background:#f8fafc}
table td{padding:12px 9px}
.live{height:220px;background:#fff}
.dashboard-map-empty{background:#fff!important;border:1px solid var(--ed-border)!important}
</style>
<style id="v179-brand-nav">
.app-logo{width:42px;height:42px;object-fit:contain;border-radius:10px;display:block;margin:0 10px 8px}
.brand-lockup{padding:0 8px 2px}
.top-brand{display:flex;align-items:center;gap:10px}
.top-logo{width:38px;height:38px;object-fit:contain;border-radius:9px}
.btn.primary,.primary{background:#f97316!important;color:#fff!important;border-color:#f97316!important}
.menu-btn.active{background:#f97316!important;color:#fff!important}
.menu-btn.active .ico{color:#fff!important}
.page-head .primary{background:#f97316!important}
</style><style id="v180-ui">
.app-shell{background:#f6f8fb}
.sidebar{background:#0f172a}
.side-brand{color:#fff}
.app-logo{background:#fff;padding:3px;box-sizing:border-box}
.top-logo{background:#fff;padding:2px;box-sizing:border-box}
.topbar{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:12px 16px}
.menu-btn.active{background:#f97316!important}
.btn,.btn.primary{background:#f97316!important;color:#fff!important}
.btn.secondary{background:#fff!important;color:#172033!important;border:1px solid #d0d5dd!important}
</style><style id="v181-pdf">.pdf-btn{background:#f97316!important;color:#fff!important;border:0;border-radius:8px;padding:8px 12px;font-weight:600}</style>
<style id="v183-fix">
html,body{overflow-x:hidden}
.main{width:calc(100% - 250px);max-width:none;min-width:0;overflow:hidden}
.wrap{width:100%;max-width:none;min-width:0;box-sizing:border-box;overflow:hidden}
#c{width:100%;min-width:0;overflow:hidden}
.grid{grid-template-columns:repeat(4,minmax(0,1fr));min-width:0}
.grid>*{min-width:0}
.panel{max-width:100%;box-sizing:border-box;overflow:hidden}
table{display:block;max-width:100%;overflow-x:auto}
.form{grid-template-columns:repeat(3,minmax(0,1fr))}
.form-2{grid-template-columns:repeat(2,minmax(0,1fr))}
.listRow{min-width:0}
.customer-main{min-width:0;flex:1}
.customer-actions{display:flex;gap:7px;flex-shrink:0}
.danger{background:#dc2626!important;color:#fff!important;border:0}
.ed-modal{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;padding:24px;box-sizing:border-box}
.ed-modal-backdrop{position:absolute;inset:0;background:rgba(15,23,42,.55)}
.ed-modal-card{position:relative;width:min(760px,calc(100vw - 48px));max-height:calc(100vh - 48px);overflow:auto;background:#fff;border-radius:16px;padding:24px;box-sizing:border-box;box-shadow:0 24px 70px rgba(0,0,0,.25)}
.ed-modal-card h2{margin-top:0}
.ed-modal-card label{display:flex;flex-direction:column;gap:6px;font-weight:600;margin-bottom:10px}
.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}
@media(max-width:1100px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.form{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.sidebar{width:210px}.main{margin-left:210px;width:calc(100% - 210px)}.grid,.form,.form-2{grid-template-columns:1fr}.page-head{align-items:flex-start;flex-direction:column}}
</style>
<style id="v184-doc">.document-action{display:flex;justify-content:flex-end;gap:8px;margin-bottom:12px}.ed-modal-card .form{gap:12px}</style><style id="v185-fix">
.page-head{flex-wrap:wrap}
.form label,.grid2 label{display:flex;flex-direction:column;gap:6px;font-weight:600}
.form input,.form select,.grid2 input,.grid2 select{width:100%;box-sizing:border-box}
.stat .row{display:flex;gap:7px;flex-wrap:wrap}
.error{padding:12px;border-radius:10px;background:#fff1f2;color:#b42318;border:1px solid #fecdd3}

.ed-pdf-modal{position:fixed;inset:0;z-index:12000;display:flex;align-items:center;justify-content:center;padding:18px;box-sizing:border-box}
.ed-pdf-backdrop{position:absolute;inset:0;background:rgba(15,23,42,.62)}
.ed-pdf-dialog{position:relative;z-index:1;width:min(1180px,calc(100vw - 36px));height:min(900px,calc(100vh - 36px));background:#fff;border-radius:16px;box-shadow:0 24px 80px rgba(0,0,0,.3);display:flex;flex-direction:column;overflow:hidden}
.ed-pdf-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;border-bottom:1px solid #e4e7ec;background:#fff}
.ed-pdf-head>div{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.ed-pdf-frame{width:100%;height:100%;border:0;background:#f3f4f6}
@media(max-width:700px){.ed-pdf-modal{padding:0}.ed-pdf-dialog{width:100vw;height:100vh;border-radius:0}.ed-pdf-head{align-items:flex-start;flex-direction:column}}
</style><style id="v195-calendar">.cal-head{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;margin-bottom:12px}.cal-head h3{min-width:190px;text-align:center;text-transform:capitalize}.cal-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));border-left:1px solid #e5e7eb;border-top:1px solid #e5e7eb}.cal-weekday{padding:9px;text-align:center;font-weight:700;background:#f8fafc;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb}.cal-day{min-height:105px;padding:7px;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;background:#fff}.muted-day{background:#f8fafc}.cal-num{font-weight:700;margin-bottom:5px}.cal-event{display:block;width:100%;text-align:left;border:0;border-radius:6px;background:#fff3e8;color:#9a3412;padding:5px 6px;margin:3px 0;cursor:pointer;font-size:11px;overflow:hidden}.cal-list{margin-top:18px}.cal-list h3{margin-bottom:8px}.cal-form-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.cal-check{display:flex!important;align-items:center;gap:7px}.cal-check input{width:auto!important;margin:0!important}.cal-modal{position:fixed;inset:0;z-index:5000;background:rgba(15,23,42,.45);display:flex;align-items:center;justify-content:center;padding:18px}.cal-dialog{width:min(620px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:14px;padding:18px;box-shadow:0 20px 70px rgba(0,0,0,.25)}.cal-modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.cal-dialog label{display:block;font-weight:600;font-size:12px;margin:10px 0}.cal-dialog input,.cal-dialog select,.cal-dialog textarea{display:block;width:100%;box-sizing:border-box;margin-top:5px;padding:10px;border:1px solid #d1d5db;border-radius:8px;font:inherit}.cal-dialog .cal-check input{display:inline-block}.btn.danger{background:#fff;color:#b91c1c;border:1px solid #fecaca}@media(max-width:700px){.cal-day{min-height:75px;padding:4px}.cal-event{font-size:10px}.cal-form-row{grid-template-columns:1fr}}}</style></head><body><div id="root"></div><script>
let S=null,T=localStorage.edv10||"";const root=document.getElementById("root");
async function api(u,o={}){o.headers={...(o.headers||{}),Authorization:"Bearer "+T};let r=await fetch(u,o);if(r.status===401){T="";localStorage.removeItem("edv10");loginView();throw 0}return r.json()}
function loginView(){root.innerHTML='<div class="login panel"><div class="brand">Emergency Delivery</div><p class="muted">Emergency Delivery · Anmeldung</p><input id="un" placeholder="Benutzername"><br><br><input id="pw" type="password" placeholder="Passwort"><br><br><button class="btn" onclick="login()">Anmelden</button><p class="muted">admin/admin123 · dispatcher/dispatch123 · driver/driver123 · accounting/account123</p></div>'}
async function login(){let r=await fetch("/api/login",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({username:un.value,password:pw.value})}),x=await r.json();if(!r.ok)return alert(x.error);T=x.token;localStorage.edv10=T;load()}
async function load(){S=await api("/api/state");S.company=S.company||{};window.currentUser=S.user;view("dashboard")}async function refreshState(){const oldPage=window.currentPage;S=await api("/api/state");S.company=S.company||{};window.currentUser=S.user;return S}
function goTo(id){
  window.scrollTo({top:0,left:0,behavior:"smooth"});
  const e=document.getElementById(id);
  if(e && e.closest("#root")) e.scrollIntoView({behavior:"smooth",block:"start"});
}
function menuBtn(label,icon,action,active=false){return `<button class="menu-btn ${active?"active":""}" onclick="${action}"><span class="ico">${icon}</span>${label}</button>`}

function compactEmptyDashboardMap(){
  document.querySelectorAll("#root .map, #root .mapGrid, #root .map-canvas").forEach(el=>{
    const txt=(el.textContent||"").trim();
    const hasMarker=el.querySelector(".marker,.vehicle-marker,.route-marker,[data-lat]");
    if(!hasMarker && txt.length<120){
      el.classList.add("dashboard-map-empty");
      el.innerHTML='<div class="empty-inner"><div class="empty-icon">⌖</div><h3>Live-Karte</h3><p>Noch keine Fahrzeuge oder Touren mit GPS-Daten vorhanden. Sobald ein Fahrzeug aktiv ist, wird die Position hier angezeigt.</p></div>';
    }
  });
}

function view(p){window.scrollTo(0,0);document.documentElement.scrollTop=0;document.body.scrollTop=0;root.innerHTML=`<div class="app-shell"><aside class="sidebar"><div class="brand-lockup"><img class="app-logo" src="/assets/emergency-delivery-logo.png" alt="Emergency Delivery"><div class="side-brand">Emergency Delivery</div></div><div class="side-sub">Transport Management · Emergency Delivery · V196</div><div class="menu-group"><div class="menu-title">Übersicht</div>${menuBtn("Dashboard","⌂","view('dashboard')",p==='dashboard')}</div><div class="menu-group"><div class="menu-title">Operativ</div>${menuBtn("Disposition","⇄","view('dispatch')",p==='dispatch')}${menuBtn("Aufträge","▣","view('orders')",p==='orders')}${menuBtn("Touren & Stopps","↔","view('tours')",p==='tours')}${menuBtn("Fahrer-App","♟","view('driver')",p==='driver')}${menuBtn("Fahrzeuge","▤","view('vehicles')",p==='vehicles')}${menuBtn("Mitarbeiter","♙","view('employees')",p==='employees')}</div><div class="menu-group"><div class="menu-title">Kunden & Finanzen</div>${menuBtn("Kunden","♙","view('customers')",p==='customers')}${menuBtn("Kundenakte","◎","view('customer360')",p==='customer360')}${menuBtn("Rechnungen","€","view('invoices')",p==='invoices')}${menuBtn("Finanz-Dashboard","▥","view('finance')",p==='finance')}</div><div class="menu-group"><div class="menu-title">Kommunikation</div>${menuBtn("Benachrichtigungen","!","view('notifications')",p==='notifications')}${S.user.role!=='Driver'?menuBtn("E-Mail","✉","view('email')",p==='email'):''}${menuBtn("Lieferscheine","▤","view('documents')",p==='documents')}${menuBtn("Kundenportal","↗","view('portal')",p==='portal')}</div><div class="menu-group"><div class="menu-title">Steuerung</div>${menuBtn("Auftrag 360°","◉","view('order360')",p==='order360')}${menuBtn("Operations Board","▦","view('operations')",p==='operations')}${menuBtn("Kalender","▦","view('calendar')",p==='calendar')}${S.user.role==='Admin'?menuBtn("Firmendaten","⚙","view('company')",p==='company'):''}</div><div class="side-bottom"><div class="side-sub">${S.user.name} · ${S.user.role}</div><button class="menu-btn" onclick="logout()"><span class="ico">↪</span>Abmelden</button></div></aside><main class="main"><div class="wrap"><div class="topbar"><div><div class="top-brand"><img class="top-logo" src="/assets/emergency-delivery-logo.png" alt=""><div class="brand">${({dashboard:'Dashboard',dispatch:'Disposition',orders:'Aufträge',tours:'Touren & Stopps',driver:'Fahrer-App',live:'Live-Fahrzeuge',vehicles:'Fahrzeuge',employees:'Mitarbeiter',customers:'Kunden',customer360:'Kundenakte',invoices:'Rechnungen',finance:'Finanz-Dashboard',notifications:'Benachrichtigungen',documents:'Lieferscheine',portal:'Kundenportal',order360:'Auftrag 360°',operations:'Operations Board',company:'Firmendaten'}[p]||'Emergency Delivery')}</div></div><div class="muted">Zentrale Steuerung von Emergency Delivery</div></div><div>${S.user.name} · ${S.user.role}</div></div><div id="c"></div></div></main></div>`;let c=document.getElementById("c"); let contentPage=(p==="orders"||p==="tours")?"dispatch":p;
if(p==="dashboard")c.innerHTML=`<div class="grid"><div class="stat"><span class="muted">Kunden</span><b>${S.customers.length}</b></div><div class="stat"><span class="muted">Offene Aufträge</span><b>${S.trips.filter(x=>x.status!=="Delivered").length}</b></div><div class="stat"><span class="muted">Rechnungsvolumen</span><b>€ ${S.invoices.reduce((a,x)=>a+Number(x.gross),0).toFixed(2)}</b></div></div><div class="panel"><div class="page-head"><div><div class="eyebrow">HEUTE</div><h2>Operativer Überblick</h2><p class="muted">Aufträge, Fahrzeuge und Fahrer zentral im Blick.</p></div><button class="btn" onclick="view('dispatch')">Disposition öffnen</button></div><div class="grid"><div class="stat"><span class="muted">Lieferungen heute</span><b>${S.trips.filter(x=>x.status==="Delivered").length}</b></div><div class="stat"><span class="muted">Rechnungen offen</span><b>${S.invoices.filter(x=>x.status!=="Paid").length}</b></div><div class="stat"><span class="muted">Fahrer</span><b>${S.users.filter(x=>x.role==="Driver").length}</b></div><div class="stat"><span class="muted">Fahrzeuge</span><b>${S.vehicles.length}</b></div></div></div>`;
if(p==="calendar"){renderCalendar();return}
if(p==="email"){renderEmail();return}
if(p==="company"){
  const x=S.company||{};
  c.innerHTML=`<div class="page-head"><div><div class="eyebrow">STAMMDATEN</div><h2>Eigene Firmendaten</h2><p class="muted">Diese Angaben werden auf Lieferscheinen und Rechnungen verwendet.</p></div></div>
  <div class="panel"><div class="form form-2">
  <label>Firmenname *<input id="coName" value="${esc(x.company_name||"")}"></label>
  <label>Rechtlicher Firmenname<input id="coLegal" value="${esc(x.legal_name||"")}"></label>
  <label>Straße / Hausnummer<input id="coAddress" value="${esc(x.address||"")}"></label>
  <label>PLZ<input id="coPostal" value="${esc(x.postal_code||"")}"></label>
  <label>Ort<input id="coCity" value="${esc(x.city||"")}"></label>
  <label>Land<input id="coCountry" value="${esc(x.country||"")}"></label>
  <label>USt-IdNr. / P.IVA<input id="coVat" value="${esc(x.vat_id||"")}"></label>
  <label>Steuernummer<input id="coTax" value="${esc(x.tax_number||"")}"></label>
  <label>Telefon<input id="coPhone" value="${esc(x.phone||"")}"></label>
  <label>E-Mail<input id="coEmail" type="email" value="${esc(x.email||"")}"></label>
  <label>Website<input id="coWebsite" value="${esc(x.website||"")}"></label>
  <label>Bank<input id="coBank" value="${esc(x.bank_name||"")}"></label>
  <label>IBAN<input id="coIban" value="${esc(x.iban||"")}"></label>
  <label>BIC<input id="coBic" value="${esc(x.bic||"")}"></label>
  </div><label style="display:block;margin-top:14px">Fußzeile / Zusatztext<input id="coFooter" value="${esc(x.footer_note||"")}"></label>
  <div class="modal-actions" style="margin-top:18px"><button class="btn primary" onclick="saveCompanySettings()">Firmendaten speichern</button></div></div>
  <div class="panel"><h3>PDF-Verwendung</h3><p class="muted">Logo, Firmenname, Adresse, Kontakt- und Zahlungsdaten werden automatisch in die PDF-Dokumente übernommen. Änderungen gelten für neu erzeugte PDFs.</p></div>`;
}
if(contentPage==="dispatch")c.innerHTML=`<div class="panel"><h2>Disposition</h2><table><tr><th>Fahrt</th><th>Route</th><th>KG</th><th>Status</th><th>Preis</th><th></th></tr>${S.trips.map(t=>`<tr><td>${t.trip_number}</td><td>${t.route||""}</td><td>${t.weight_kg} KG</td><td>${t.status}</td><td>€ ${Number(t.price_net||0).toFixed(2)}</td><td><button class="btn secondary" onclick="editTrip('${t.id}')">Bearbeiten</button><button class="btn secondary" onclick="previewPdf('ddt','${t.id}')">Lieferschein Vorschau</button><button class="btn secondary" onclick="ddt('${t.id}')">PDF</button></td></tr>`).join("")}</table></div><div class="panel"><h3>Neue Fahrt</h3><div class="form"><select id="tc">${S.customers.map(x=>`<option value="${x.id}">${x.company}</option>`)}</select><input id="w" type="number" placeholder="KG"><input id="rt" placeholder="Route"><select id="dr">${S.users.filter(x=>x.role==="Driver").map(x=>`<option value="${x.id}">${x.name}</option>`).join("")}</select><select id="ve">${S.vehicles.map(x=>`<option value="${x.id}">${x.name}</option>`).join("")}</select><input id="pc" type="number" value="1"><input id="price" type="number" placeholder="Netto Preis EUR"><input id="nt" placeholder="Notiz"></div><br><button class="btn" onclick="trip()">Erstellen</button></div><div class="panel"><h3>Tour optimieren</h3><div class="form"><input id="org" value="Milano" placeholder="Start"><input id="dst" value="Milano" placeholder="Ziel"><select id="tripsel" multiple size="4">${S.trips.map(t=>`<option value="${t.id}">${t.trip_number} · ${t.route||""}</option>`).join("")}</select></div><br><button class="btn" onclick="opt()">Stopps nach Ort sortieren + Google Maps</button><div id="optout"></div></div>`;
if(p==="vehicles"){c.innerHTML=`<div class="page-head"><div><div class="eyebrow">FUHRPARK</div><h2>Fahrzeuge</h2><p class="muted">Fahrzeuge anlegen, bearbeiten und erweitern.</p></div><button class="btn primary" onclick="openVehicle()">+ Fahrzeug hinzufügen</button></div><div class="grid">${S.vehicles.map(v=>`<div class="stat"><span>${esc(v.name)}</span><b>${esc(v.plate)}</b><div class="muted">${esc(v.make||"")} ${esc(v.model||"")} · ${v.active===false?"Inaktiv":"Aktiv"}</div><div class="row" style="margin-top:10px"><button class="btn secondary" onclick="openVehicle('${v.id}')">Bearbeiten</button><button class="btn secondary" onclick="deleteVehicle('${v.id}')">Löschen</button></div></div>`).join("")}</div>`;}
if(p==="live")c.innerHTML=`<div class="panel"><h2>Live-Fahrzeuge</h2><p class="muted">Positionen werden automatisch alle 10 Sekunden aktualisiert.</p><div class="live" id="livebox"></div></div>`; if(p==="live"){live();setInterval(live,10000)}
if(p==="driver"){let m=S.trips.filter(t=>t.driver_id===S.user.id);c.innerHTML=`<div class="panel"><h2>Fahrer-App</h2>${m.map(t=>`<div class="panel"><b>${t.trip_number}</b> · ${t.route||""}<p>${t.weight_kg} KG · ${t.status}</p><div class="row"><button class="btn" onclick="st('${t.id}','In Transit')">Unterwegs</button><button class="btn" onclick="st('${t.id}','Delivered')">Geliefert</button><button class="btn secondary" onclick="nav('${t.route||""}')">Navigation</button></div>${t.status==="Delivered"?`<h4>Unterschrift</h4><canvas class="sig" id="sig-${t.id}" width="700" height="180"></canvas><br><button class="btn" onclick="save('${t.id}')">Unterschrift speichern</button>`:""}</div>`).join("")||"Keine Fahrten."}</div>`;m.filter(t=>t.status==="Delivered").forEach(t=>canvas(t.id))}
if(p==="customers"){
  c.innerHTML=`<div class="page-head"><div><div class="eyebrow">STAMMDATEN</div><h2>Kunden</h2><p class="muted">Kunden anlegen, bearbeiten und verwalten.</p></div><button class="btn primary" onclick="openCustomer()">+ Kunde hinzufügen</button></div><div class="panel"><div id="customerList">Lade Kunden…</div></div>`;
  loadCustomersManage(); return;
}
if(p==="invoices")c.innerHTML=`<div class="page-head"><div><div class="eyebrow">FINANZEN</div><h2>Rechnungen</h2><p class="muted">Rechnungen automatisch oder manuell erstellen und bearbeiten.</p></div><button class="btn primary" onclick="openInvoice()">+ Rechnung erstellen</button></div><div class="panel"><table><tr><th>Nr.</th><th>Kunde</th><th>Netto</th><th>Brutto</th><th>Status</th><th>Aktionen</th></tr>${S.invoices.map(i=>{const cu=S.customers.find(c=>c.id===i.customer_id);return `<tr><td>${i.invoice_number}</td><td>${esc(cu?.company||"")}</td><td>€ ${Number(i.net).toFixed(2)}</td><td>€ ${Number(i.gross).toFixed(2)}</td><td>${i.status}</td><td><button class="btn secondary" onclick="editInvoice('${i.id}')">Bearbeiten</button> <button class="btn secondary" onclick="previewPdf('invoice','${i.id}')">PDF Vorschau</button> <button class="btn secondary" onclick="inv('${i.id}')">PDF</button></td></tr>`}).join("")}</table></div>`;
if(p==="finance")c.innerHTML=`<div class="panel"><h2>Finanz-Dashboard</h2><div class="grid"><div class="stat"><span>Rechnungsvolumen</span><b>€ ${S.invoices.reduce((a,x)=>a+Number(x.gross),0).toFixed(2)}</b></div><div class="stat"><span>Offene Rechnungen</span><b>${S.invoices.filter(x=>x.status!=="Paid").length}</b></div></div></div>`;
if(p==="customer360"){c.innerHTML=`<div class="page-head"><div><div class="eyebrow">KUNDENAKTE</div><h2>Kundenakte</h2><p class="muted">Aufträge, Touren, Rechnungen, DDT und Kommunikation an einer Stelle.</p></div><select id="c360Select" onchange="loadCustomer360(this.value)">${S.customers.map(x=>`<option value="${x.id}">${esc(x.company)}</option>`).join("")}</select></div><div id="customer360Box"><p class="muted">Kundenakte wird geladen…</p></div>`;if(S.customers[0])loadCustomer360(S.customers[0].id);}
if(p==="notifications")c.innerHTML=`<div class="panel"><h2>Benachrichtigungen</h2><p class="muted">Aktuelle System- und Betriebsereignisse.</p></div>`;
if(p==="communication")c.innerHTML=`<div class="panel"><h2>Kommunikation</h2><p class="muted">Kundenkommunikation und Vorlagen.</p></div>`;
if(p==="documents")c.innerHTML=`<div class="page-head"><div><div class="eyebrow">LIEFERSCHEINE</div><h2>Lieferscheine & Rechnungen</h2><p class="muted">Lieferscheine erstellen, bearbeiten und als PDF herunterladen.</p></div><button class="btn primary" onclick="openDdt()">+ Lieferschein erstellen</button></div><div class="panel"><h3>Lieferscheine</h3><div class="list">${S.trips.map(t=>`<div class="listRow"><div><b>${t.trip_number}</b><div class="muted">${esc((S.customers.find(c=>c.id===t.customer_id)||{}).company||"")} · ${t.status}</div></div><div class="row"><button class="btn secondary" onclick="editDdt('${t.id}')">Bearbeiten</button><button class="btn secondary" onclick="previewPdf('ddt','${t.id}')">PDF Vorschau</button><button class="btn secondary" onclick="ddt('${t.id}')">Lieferschein PDF</button></div></div>`).join("")||"<p class='muted'>Keine Lieferscheine vorhanden.</p>"}</div><h3>Rechnungen</h3><div class="list">${S.invoices.map(i=>`<div class="listRow"><div><b>${i.invoice_number}</b><div class="muted">${i.status}</div></div><div class="row"><button class="btn secondary" onclick="editInvoice('${i.id}')">Bearbeiten</button><button class="btn secondary" onclick="previewPdf('invoice','${i.id}')">PDF Vorschau</button><button class="btn secondary" onclick="inv('${i.id}')">Rechnung PDF</button></div></div>`).join("")||"<p class='muted'>Keine Rechnungen vorhanden.</p>"}</div></div>`;
if(p==="email")c.innerHTML=`<div class="page-head"><div><div class="eyebrow">KOMMUNIKATION</div><h2>E-Mail senden</h2><p class="muted">E-Mails direkt aus Emergency Delivery senden und optional Rechnung oder Lieferschein anhängen.</p></div></div><div class="panel"><form id="emailCompose"><div class="grid2"><label>Kunde<select id="mailCustomer"><option value="">— Kunde auswählen —</option>${S.customers.map(x=>`<option value="${x.id}" data-email="${esc(x.email||'')}">${esc(x.company)}${x.email?' · '+esc(x.email):''}</option>`).join('')}</select></label><label>Empfänger E-Mail<input id="mailTo" type="email" required placeholder="kunde@firma.it"></label><label>CC <input id="mailCc" placeholder="Optional, mehrere mit Komma"></label><label>Betreff<input id="mailSubject" required placeholder="Betreff"></label></div><label>Nachricht<textarea id="mailBody" rows="10" required placeholder="Ihre Nachricht…"></textarea><div class="grid2"><label>Rechnung anhängen<select id="mailInvoice"><option value="">Keine Rechnung</option>${S.invoices.map(x=>`<option value="${x.id}">${esc(x.invoice_number)} · € ${Number(x.gross||0).toFixed(2)}</option>`).join('')}</select></label><label>Lieferschein anhängen<select id="mailTrip"><option value="">Kein Lieferschein</option>${S.trips.map(x=>`<option value="${x.id}">${esc(x.trip_number)} · ${esc(x.route||'')}</option>`).join('')}</select></label></div><div class="actions"><button class="btn primary" type="submit">✉ E-Mail senden</button></div><div id="mailMsg" class="muted"></div></form></div><div class="panel"><h3>Versandverlauf</h3><div id="mailOutbox">Lade E-Mails…</div></div>`;setTimeout(initEmailComposer,0);if(p==="portal")c.innerHTML=`<div class="panel"><h2>Kundenportal</h2><p class="muted">Kundenportal und Sendungsverfolgung.</p></div>`;
if(p==="order360")renderOrder360();
if(p==="operations")renderOperationsBoard();
if(p==="employees"){
  c.innerHTML=`<div class="page-head"><div><div class="eyebrow">STAMMDATEN</div><h2>Mitarbeiterdatei</h2><p class="muted">Fahrer und Mitarbeiter mit Kontaktdaten, Führerschein, Eintritt und Fahrzeugzuordnung.</p></div><button class="btn primary" onclick="loadEmployeeVehicles().then(()=>openEmployee())">+ Mitarbeiter hinzufügen</button></div><div class="panel employee-panel"><div id="employeeList">Lade Mitarbeiter…</div></div>`;
  loadEmployees(); return;
}
}

function initEmailComposer(){const f=document.getElementById('emailCompose');if(!f)return;const sel=document.getElementById('mailCustomer');sel.addEventListener('change',()=>{const o=sel.selectedOptions[0];if(o&&o.dataset.email)document.getElementById('mailTo').value=o.dataset.email;});f.addEventListener('submit',sendDirectEmail);loadMailOutbox();}
async function sendDirectEmail(e){e.preventDefault();const msg=document.getElementById('mailMsg');msg.textContent='E-Mail wird gesendet…';try{const b={customerId:document.getElementById('mailCustomer').value||null,to:document.getElementById('mailTo').value.trim(),cc:document.getElementById('mailCc').value.trim(),subject:document.getElementById('mailSubject').value.trim(),body:document.getElementById('mailBody').value,invoiceId:document.getElementById('mailInvoice').value||null,tripId:document.getElementById('mailTrip').value||null};const r=await api('/api/email/send-direct',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)});msg.textContent=r.message||'E-Mail erfolgreich gesendet.';document.getElementById('mailBody').value='';loadMailOutbox();}catch(err){msg.textContent='Fehler: '+err.message;}}
async function loadMailOutbox(){const box=document.getElementById('mailOutbox');if(!box)return;try{const d=await api('/api/email/outbox');box.innerHTML=(d||[]).map(x=>`<div class="listRow"><div><b>${esc(x.subject||'')}</b><div class="muted">${esc(x.recipient||'')}</div></div><div class="muted">${esc(x.status||'')} · ${x.sent_at||x.queued_at||''}</div></div>`).join('')||'<p class="muted">Noch keine E-Mails.</p>';}catch(e){box.innerHTML='<p class="error">'+esc(e.message)+'</p>';}}

let calEvents=[],calMonth=new Date(new Date().getFullYear(),new Date().getMonth(),1),calEditId=null;
function calIso(d){return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
function calFmt(v){return new Date(v+'T00:00:00').toLocaleDateString('de-DE')}
async function renderCalendar(){
  c.innerHTML=`<div class="page-head"><div><div class="eyebrow">PLANUNG</div><h2>Kalender</h2><p class="muted">Termine und Veranstaltungen eintragen, bearbeiten und löschen.</p></div><button class="btn primary" onclick="calOpen()">+ Neuer Termin</button></div><div class="panel"><div id="calendarBox">Lade Kalender…</div></div>`;
  await calendarLoad();
}
async function calendarLoad(){const first=new Date(calMonth.getFullYear(),calMonth.getMonth(),1),last=new Date(calMonth.getFullYear(),calMonth.getMonth()+1,0);calEvents=await api(`/api/calendar/events?from=${calIso(first)}&to=${calIso(last)}`);calDraw()}
function calDraw(){
  const y=calMonth.getFullYear(),m=calMonth.getMonth(),first=new Date(y,m,1),days=new Date(y,m+1,0).getDate(),offset=(first.getDay()+6)%7,names=['Mo','Di','Mi','Do','Fr','Sa','So'];let cells='';
  for(let i=0;i<offset;i++)cells+='<div class="cal-day muted-day"></div>';
  for(let d=1;d<=days;d++){const iso=`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`,ev=calEvents.filter(e=>String(e.start_date||'').slice(0,10)<=iso&&String(e.end_date||e.start_date||'').slice(0,10)>=iso);cells+=`<div class="cal-day"><div class="cal-num">${d}</div>${ev.map(e=>`<button class="cal-event" onclick="calOpen('${e.id}')"><b>${e.all_day?'':(e.start_time||'')}</b> ${esc(e.title)}</button>`).join('')}</div>`}
  calendarBox.innerHTML=`<div class="cal-head"><button class="btn secondary" onclick="calPrev()">‹</button><h3>${calMonth.toLocaleDateString('de-DE',{month:'long',year:'numeric'})}</h3><button class="btn secondary" onclick="calNext()">›</button><button class="btn secondary" onclick="calToday()">Heute</button><span class="muted">${calEvents.length} Termin${calEvents.length===1?'':'e'} in diesem Monat</span></div><div class="cal-grid">${names.map(n=>`<div class="cal-weekday">${n}</div>`).join('')}${cells}</div><div class="cal-list"><h3>Termine im Monat</h3>${calEvents.length?calEvents.map(e=>`<div class="listRow"><div><b>${esc(e.title)}</b><div class="muted">${calFmt(String(e.start_date).slice(0,10))}${e.end_date&&String(e.end_date).slice(0,10)!==String(e.start_date).slice(0,10)?' – '+calFmt(String(e.end_date).slice(0,10)):''}${e.start_time?' · '+e.start_time:''}${e.location?' · '+esc(e.location):''}</div></div><div class="row"><button class="btn secondary" onclick="calOpen('${e.id}')">Bearbeiten</button><button class="btn danger" onclick="calDelete('${e.id}')">Löschen</button></div></div>`).join(''):'<p class="muted">Keine Termine in diesem Monat.</p>'}</div>`;
}
function calPrev(){calMonth=new Date(calMonth.getFullYear(),calMonth.getMonth()-1,1);calendarLoad()}
function calNext(){calMonth=new Date(calMonth.getFullYear(),calMonth.getMonth()+1,1);calendarLoad()}
function calToday(){const n=new Date();calMonth=new Date(n.getFullYear(),n.getMonth(),1);calendarLoad()}
function calOpen(id){
  calEditId=id||null;const e=id?calEvents.find(x=>x.id===id):null,ov=document.createElement('div');ov.className='cal-modal';ov.id='calModal';
  ov.innerHTML=`<div class="cal-dialog"><div class="cal-modal-head"><h3>${e?'Termin bearbeiten':'Neuer Termin'}</h3><button type="button" class="btn secondary" onclick="calClose()">×</button></div><form onsubmit="calSave(event)"><label>Titel<input id="calTitle" required value="${esc(e?.title||'')}"></label><label>Art<select id="calType"><option ${e?.event_type==='Termin'?'selected':''}>Termin</option><option ${e?.event_type==='Veranstaltung'?'selected':''}>Veranstaltung</option><option ${e?.event_type==='Besprechung'?'selected':''}>Besprechung</option><option ${e?.event_type==='Sonstiges'?'selected':''}>Sonstiges</option></select></label><div class="cal-form-row"><label>Startdatum<input id="calStartDate" type="date" required value="${e?.start_date||calIso(calMonth)}"></label><label>Enddatum<input id="calEndDate" type="date" value="${e?.end_date||e?.start_date||calIso(calMonth)}"></label></div><div class="cal-form-row"><label>Startzeit<input id="calStartTime" type="time" value="${e?.start_time||''}"></label><label>Endzeit<input id="calEndTime" type="time" value="${e?.end_time||''}"></label></div><label class="cal-check"><input id="calAllDay" type="checkbox" ${e?.all_day?'checked':''}> Ganztägig</label><label>Ort<input id="calLocation" value="${esc(e?.location||'')}"></label><label>Beschreibung<textarea id="calDescription" rows="4">${esc(e?.description||'')}</textarea></label><div class="modal-actions"><button type="button" class="btn secondary" onclick="calClose()">Abbrechen</button>${e?`<button type="button" class="btn danger" onclick="calDelete('${e.id}')">Löschen</button>`:''}<button class="btn primary" type="submit">Speichern</button></div></form></div>`;
  document.body.appendChild(ov);
}
function calClose(){document.getElementById('calModal')?.remove()}
async function calSave(ev){ev.preventDefault();const b={title:calTitle.value.trim(),description:calDescription.value,startDate:calStartDate.value,startTime:calAllDay.checked?null:(calStartTime.value||null),endDate:calEndDate.value||calStartDate.value,endTime:calAllDay.checked?null:(calEndTime.value||null),allDay:calAllDay.checked,location:calLocation.value.trim(),eventType:calType.value};if(!b.title)return alert('Titel ist erforderlich.');if(!b.startDate)return alert('Startdatum ist erforderlich.');if(b.endDate<b.startDate)return alert('Das Enddatum darf nicht vor dem Startdatum liegen.');await api(calEditId?`/api/calendar/events/${calEditId}`:'/api/calendar/events',{method:calEditId?'PATCH':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)});calMonth=new Date(Number(b.startDate.slice(0,4)),Number(b.startDate.slice(5,7))-1,1);calClose();alert(calEditId?'Termin aktualisiert.':'Termin gespeichert.');await calendarLoad()}
async function calDelete(id){if(!confirm('Termin wirklich löschen?'))return;await api('/api/calendar/events/'+id,{method:'DELETE'});calClose();alert('Termin gelöscht.');await calendarLoad()}
async function trip(){const weight=Number(document.getElementById("w").value||0),priceNet=Number(document.getElementById("price").value||0);if(weight>1000)return alert("Maximal 1.000 KG");if(priceNet<0)return alert("Preis darf nicht negativ sein");await api("/api/trips",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({customerId:document.getElementById("tc").value,weightKg:weight,route:document.getElementById("rt").value,driverId:document.getElementById("dr").value,vehicleId:document.getElementById("ve").value,pieces:Number(document.getElementById("pc").value||1),priceNet,notes:document.getElementById("nt").value})});await refreshState();view("dispatch")}
async function opt(){let ids=[...tripsel.selectedOptions].map(x=>x.value);let r=await api("/api/routes/optimize",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({tripIds:ids,origin:org.value,destination:dst.value})});optout.innerHTML="<p>"+r.ordered.map(x=>x.position+". "+x.tripNumber+" · "+(x.city||"")).join("<br>")+"</p><button class='btn' onclick=\"window.open('"+r.mapsUrl+"','_blank')\">Google Maps öffnen</button>"}
async function st(id,s){await api("/api/trips/"+id,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify({status:s})});load()}
async function gps(id){if(!navigator.geolocation)return alert("GPS nicht verfügbar");navigator.geolocation.getCurrentPosition(async p=>{await api("/api/gps",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({tripId:id,lat:p.coords.latitude,lng:p.coords.longitude,accuracy:p.coords.accuracy})});alert("GPS gespeichert")},e=>alert(e.message),{enableHighAccuracy:true})}
function nav(r){window.open("https://www.google.com/maps/search/?api=1&query="+encodeURIComponent(r),"_blank")}
function canvas(id){let x=document.getElementById("sig-"+id),c=x.getContext("2d"),d=false;x.onpointerdown=e=>{d=true;c.beginPath();c.moveTo(e.offsetX,e.offsetY)};x.onpointermove=e=>{if(d){c.lineTo(e.offsetX,e.offsetY);c.stroke()}};x.onpointerup=()=>d=false}
async function save(id){let x=document.getElementById("sig-"+id);await api("/api/trips/"+id,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify({signature_data:x.toDataURL("image/png"),signature_at:new Date().toISOString()})});alert("Unterschrift gespeichert")}
async function live(){let s=await api("/api/state");livebox.innerHTML=s.gps.map(g=>{let t=s.trips.find(x=>x.id===g.trip_id),u=s.users.find(x=>x.id===g.driver_id);return `<div class="vehicle"><span class="dot"></span><b>${u?.name||"Fahrer"}</b> · ${t?.trip_number||""}<br>${g.lat}, ${g.lng} · ${new Date(g.created_at).toLocaleString()} <button class="btn secondary" onclick="window.open('https://www.google.com/maps?q=${g.lat},${g.lng}','_blank')">Maps</button></div>`}).join("")||"Keine aktuellen GPS-Daten."}
async function cust(){await api("/api/customers",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({company:co.value,vatId:va.value,address:ad.value,city:ci.value,email:em.value,phone:ph.value})});load()}
async function saveCompanySettings(){
  const body={company_name:document.getElementById("coName").value.trim(),legal_name:document.getElementById("coLegal").value.trim(),address:document.getElementById("coAddress").value.trim(),postal_code:document.getElementById("coPostal").value.trim(),city:document.getElementById("coCity").value.trim(),country:document.getElementById("coCountry").value.trim(),vat_id:document.getElementById("coVat").value.trim(),tax_number:document.getElementById("coTax").value.trim(),phone:document.getElementById("coPhone").value.trim(),email:document.getElementById("coEmail").value.trim(),website:document.getElementById("coWebsite").value.trim(),bank_name:document.getElementById("coBank").value.trim(),iban:document.getElementById("coIban").value.trim(),bic:document.getElementById("coBic").value.trim(),footer_note:document.getElementById("coFooter").value.trim()};
  if(!body.company_name)return alert("Firmenname ist erforderlich.");
  try{S.company=await api("/api/company-settings",{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});alert("Firmendaten gespeichert.");view("company");}catch(e){alert(e.message)}
}
function downloadPdf(url,name){
  fetch(url,{headers:{Authorization:"Bearer "+T}}).then(async r=>{
    if(!r.ok) throw new Error((await r.text())||"PDF konnte nicht erstellt werden");
    const blob=await r.blob();
    const a=document.createElement("a"); a.href=URL.createObjectURL(blob); a.download=name+".pdf";
    document.body.appendChild(a); a.click();
    setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},1000);
  }).catch(e=>alert(e.message));
}
let edPdfPreviewUrl="";
function closePdfPreview(){
  const m=document.getElementById("edPdfPreviewModal");
  if(m)m.remove();
  if(edPdfPreviewUrl){URL.revokeObjectURL(edPdfPreviewUrl);edPdfPreviewUrl="";}
}
async function previewPdf(type,id){
  try{
    const path=type==="invoice"?"/api/documents/invoice/":"/api/documents/ddt/";
    const r=await fetch(path+encodeURIComponent(id)+"/pdf",{headers:{Authorization:"Bearer "+T}});
    if(!r.ok)throw new Error((await r.text())||"PDF konnte nicht geladen werden");
    const blob=await r.blob();
    if(edPdfPreviewUrl)URL.revokeObjectURL(edPdfPreviewUrl);
    edPdfPreviewUrl=URL.createObjectURL(blob);
    const title=type==="invoice"?"Rechnung PDF-Vorschau":"Lieferschein PDF-Vorschau";
    const old=document.getElementById("edPdfPreviewModal");if(old)old.remove();
    const m=document.createElement("div");m.id="edPdfPreviewModal";m.className="ed-pdf-modal";
    m.innerHTML=`<div class="ed-pdf-backdrop" onclick="closePdfPreview()"></div><div class="ed-pdf-dialog"><div class="ed-pdf-head"><b>${title}</b><div><button class="btn secondary" onclick="window.open(edPdfPreviewUrl,'_blank')">In neuem Fenster</button><button class="btn" onclick="closePdfPreview()">Schließen</button></div></div><iframe class="ed-pdf-frame" src="${edPdfPreviewUrl}" title="${title}"></iframe></div>`;
    document.body.appendChild(m);
  }catch(e){alert("PDF-Vorschau konnte nicht geladen werden: "+e.message)}
}
function inv(id){const i=S.invoices.find(x=>x.id===id);downloadPdf("/api/documents/invoice/"+id+"/pdf",i?.invoice_number||"Rechnung")}
function ddt(id){const t=S.trips.find(x=>x.id===id);downloadPdf("/api/documents/ddt/"+id+"/pdf",t?.trip_number||"Lieferschein")}
function editInvoice(id){
  const i=S.invoices.find(x=>x.id===id); if(!i)return;
  modal(`<h2>Rechnung ${esc(i.invoice_number)} bearbeiten</h2>
    <div class="form form-2">
      <label>Kunde<select id="eiCustomer">${S.customers.map(x=>`<option value="${x.id}" ${x.id===i.customer_id?"selected":""}>${esc(x.company)}</option>`).join("")}</select></label>
      <label>Netto (€)<input id="eiNet" type="number" min="0" step="0.01" value="${Number(i.net||0).toFixed(2)}"></label>
      <label>USt.-Satz (%)<input id="eiVat" type="number" min="0" step="0.1" value="${Number(i.vat_rate||0)}"></label>
      <label>Fällig am<input id="eiDue" type="date" value="${esc((i.due_date||"").slice(0,10))}"></label>
      <label>Status<select id="eiStatus">${["Open","Paid","Cancelled"].map(x=>`<option value="${x}" ${i.status===x?"selected":""}>${x}</option>`).join("")}</select></label>
      <label>Beschreibung<input id="eiDesc" value="${esc(i.description||"")}"></label>
    </div>
    <div class="modal-actions"><button class="btn secondary" onclick="closeModal()">Abbrechen</button><button class="btn primary" onclick="saveInvoiceEdit('${id}')">Speichern</button></div>`);
}
async function saveInvoiceEdit(id){
  const body={customerId:document.getElementById("eiCustomer").value,net:Number(document.getElementById("eiNet").value||0),vatRate:Number(document.getElementById("eiVat").value||0),dueDate:document.getElementById("eiDue").value||null,status:document.getElementById("eiStatus").value,description:document.getElementById("eiDesc").value.trim()};
  try{await api("/api/invoices/"+id,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});closeModal();await refreshState();view("invoices")}catch(e){alert(e.message)}
}
async function editDdt(tripId){
  const t=S.trips.find(x=>x.id===tripId); if(!t)return;
  try{
    const d=await api("/api/trips/"+tripId+"/ddt");
    const stop=(await api("/api/trips/"+tripId+"/stops").catch(()=>[]))[0]||{};
    const parts=String(t.route||"").split(" → ");
    const drivers=S.users.filter(x=>x.role==="Driver");
    modal(`<h2>Lieferschein ${esc(d.document_number||t.trip_number)} bearbeiten</h2>
      <div class="form form-2">
        <label>Kunde<select id="edCustomer">${S.customers.map(x=>`<option value="${x.id}" ${x.id===t.customer_id?"selected":""}>${esc(x.company)}</option>`).join("")}</select></label>
        <label>Lieferadresse<input id="edAddress" value="${esc(stop.address||parts[1]||"")}"></label>
        <label>Abholadresse<input id="edPickup" value="${esc(parts[0]||"")}"></label>
        <label>Gewicht (KG)<input id="edWeight" type="number" min="0" max="1000" value="${Number(t.weight_kg||0)}"></label>
        <label>Stückzahl<input id="edPieces" type="number" min="1" value="${Number(t.pieces||1)}"></label>
        <label>Fahrer<select id="edDriver"><option value="">Nicht zugewiesen</option>${drivers.map(x=>`<option value="${x.id}" ${x.id===t.driver_id?"selected":""}>${esc(x.name)}</option>`).join("")}</select></label>
        <label>Fahrzeug<select id="edVehicle"><option value="">Nicht zugewiesen</option>${S.vehicles.map(x=>`<option value="${x.id}" ${x.id===t.vehicle_id?"selected":""}>${esc(x.name)} · ${esc(x.plate)}</option>`).join("")}</select></label>
        <label>Status<select id="edStatus">${["Open","Completed","Cancelled"].map(x=>`<option value="${x}" ${d.status===x?"selected":""}>${x}</option>`).join("")}</select></label>
        <label>Notiz<input id="edNotes" value="${esc(t.notes||"")}"></label>
      </div>
      <div class="modal-actions"><button class="btn secondary" onclick="closeModal()">Abbrechen</button><button class="btn primary" onclick="saveDdtEdit('${d.id}')">Speichern</button></div>`);
  }catch(e){alert(e.message)}
}
async function saveDdtEdit(id){
  const cst=S.customers.find(x=>x.id===document.getElementById("edCustomer").value);
  const body={customerId:document.getElementById("edCustomer").value,customerName:cst?.company||"",address:document.getElementById("edAddress").value.trim(),pickupAddress:document.getElementById("edPickup").value.trim(),weightKg:Number(document.getElementById("edWeight").value||0),pieces:Number(document.getElementById("edPieces").value||1),driverId:document.getElementById("edDriver").value||null,vehicleId:document.getElementById("edVehicle").value||null,status:document.getElementById("edStatus").value,notes:document.getElementById("edNotes").value.trim()};
  if(!body.address)return alert("Lieferadresse ist erforderlich.");
  try{await api("/api/documents/ddt/"+id,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});closeModal();await refreshState();view("documents")}catch(e){alert(e.message)}
}
async function logout(){T="";localStorage.removeItem("edv10");location.reload()}if(T)load();else loginView();

window.employeeCache=[];window.employeeVehicles=[];
async function loadEmployees(){const box=document.getElementById("employeeList");if(!box)return;box.innerHTML="<p class='muted'>Mitarbeiter werden geladen…</p>";try{const r=await api("/api/employees");if(!Array.isArray(r))throw new Error(r?.error||"Mitarbeiter konnten nicht geladen werden.");window.employeeCache=r;box.innerHTML=r.length?r.map(e=>`<div class="listRow" style="padding:16px 4px"><div style="flex:1"><b>${esc(e.name)}</b><div class="muted">${esc(roleLabel(e.role))} · ${e.active===false?"Inaktiv":"Aktiv"}${e.vehicle_name?` · ${esc(e.vehicle_name)} (${esc(e.vehicle_plate||"")})`:""}</div><div class="muted">${esc(e.phone||"Keine Telefonnummer")} · ${esc(e.email||"Keine E-Mail")}</div></div><div><button onclick="loadEmployeeVehicles().then(()=>openEmployee('${e.id}'))">Bearbeiten</button>${window.currentUser?.role==="Admin"?` <button class="danger" onclick="deleteEmployee('${e.id}')">Löschen</button>`:""}</div></div>`).join(""):"<p>Noch keine Mitarbeiter vorhanden.</p>"}catch(e){box.innerHTML='<p class="error">'+esc(e.message)+'</p>'}}
function roleLabel(r){return r==="Driver"?"Fahrer":r==="Dispatcher"?"Dispatcher":r==="Accounting"?"Buchhaltung":"Administrator"}
async function loadEmployeeVehicles(){const r=await api("/api/employee-vehicles");window.employeeVehicles=Array.isArray(r)?r:[];}
function openEmployee(id){const e=(window.employeeCache||[]).find(x=>x.id===id)||{};const vo=window.employeeVehicles.map(v=>`<option value="${v.id}" ${e.assigned_vehicle_id===v.id?"selected":""}>${esc(v.name)} – ${esc(v.plate)}</option>`).join("");modal(`<h2>${id?"Mitarbeiter bearbeiten":"Mitarbeiter hinzufügen"}</h2><div class="grid2"><label>Name<input id="empName" value="${esc(e.name||"")}"></label><label>Benutzername<input id="empUser" value="${esc(e.username||"")}" ${id?"disabled":""}></label><label>Rolle<select id="empRole">${["Driver","Dispatcher","Accounting","Admin"].map(r=>`<option value="${r}" ${e.role===r?"selected":""}>${roleLabel(r)}</option>`).join("")}</select></label><label>Telefon<input id="empPhone" value="${esc(e.phone||"")}"></label><label>E-Mail<input id="empEmail" type="email" value="${esc(e.email||"")}"></label><label>Eintrittsdatum<input id="empEntry" type="date" value="${esc((e.entry_date||"").slice(0,10))}"></label><label>Adresse<input id="empAddress" value="${esc(e.address||"")}"></label><label>PLZ<input id="empPostal" value="${esc(e.postal_code||"")}"></label><label>Ort<input id="empCity" value="${esc(e.city||"")}"></label><label>Führerscheinklasse<select id="empLicense"><option value="">– keine –</option>${["B","BE","C1","C1E","C","CE"].map(x=>`<option ${e.license_class===x?"selected":""}>${x}</option>`).join("")}</select></label><label>Fahrzeug<select id="empVehicle"><option value="">– kein Fahrzeug –</option>${vo}</select></label><label>Status<select id="empActive"><option value="true" ${e.active!==false?"selected":""}>Aktiv</option><option value="false" ${e.active===false?"selected":""}>Inaktiv</option></select></label><label>${id?"Neues Passwort (optional)":"Passwort"}<input id="empPassword" type="password"></label></div><div class="actions"><button onclick="closeModal()">Abbrechen</button><button class="primary" onclick="saveEmployee('${id||""}')">Speichern</button></div>`)}
async function saveEmployee(id){const body={name:document.getElementById("empName").value.trim(),role:document.getElementById("empRole").value,phone:document.getElementById("empPhone").value.trim(),email:document.getElementById("empEmail").value.trim(),entry_date:document.getElementById("empEntry").value||null,address:document.getElementById("empAddress").value.trim(),postal_code:document.getElementById("empPostal").value.trim(),city:document.getElementById("empCity").value.trim(),license_class:document.getElementById("empLicense").value||null,assigned_vehicle_id:document.getElementById("empVehicle").value||null,active:document.getElementById("empActive").value==="true"};const pw=document.getElementById("empPassword").value;if(pw)body.password=pw;if(!id){body.username=document.getElementById("empUser").value.trim();if(!body.username||!pw){alert("Benutzername und Passwort sind erforderlich.");return}}if(!body.name){alert("Name ist erforderlich.");return}try{await api(id?"/api/employees/"+id:"/api/employees",{method:id?"PATCH":"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});closeModal();await refreshState();loadEmployees()}catch(e){alert(e.message)}}
async function deleteEmployee(id){if(!confirm("Mitarbeiter wirklich löschen?"))return;try{await api("/api/employees/"+id,{method:"DELETE"});loadEmployees()}catch(e){alert(e.message)}}

function esc(v){return String(v??"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;")}
function modal(html){
  let m=document.getElementById("ed-modal");
  if(!m){m=document.createElement("div");m.id="ed-modal";m.className="ed-modal";document.body.appendChild(m)}
  m.innerHTML=`<div class="ed-modal-backdrop" onclick="closeModal()"></div><div class="ed-modal-card">${html}</div>`;
  m.style.display="flex";
}
function closeModal(){const m=document.getElementById("ed-modal");if(m)m.style.display="none"}
async function loadCustomersManage(){
  const box=document.getElementById("customerList");if(!box)return;
  try{
    const r=await api("/api/customers/manage");
    if(!Array.isArray(r))throw new Error(r?.error||"Kunden konnten nicht geladen werden");
    window.customerCache=r;
    box.innerHTML=r.length?r.map(x=>`<div class="listRow customer-row">
      <div class="customer-main"><b>${esc(x.company)}</b><div class="muted">${esc(x.vat_id||"Keine P.IVA")} · ${esc(x.city||"Kein Ort")}</div><div class="muted">${esc(x.email||"Keine E-Mail")} · ${esc(x.phone||"Keine Telefonnummer")}</div></div>
      <div class="customer-actions"><button class="btn secondary" onclick="openCustomer('${x.id}')">Bearbeiten</button><button class="btn danger" onclick="deleteCustomer('${x.id}')">Löschen</button></div>
    </div>`).join(""):"<p class='muted'>Noch keine Kunden vorhanden.</p>";
  }catch(e){box.innerHTML=`<div class="error">${esc(e.message)}</div>`}
}
function openCustomer(id){
  const x=(window.customerCache||[]).find(v=>v.id===id)||{};
  modal(`<h2>${id?"Kunde bearbeiten":"Kunde hinzufügen"}</h2>
    <div class="form form-2">
      <label>Firma<input id="cuCompany" value="${esc(x.company)}"></label>
      <label>P.IVA<input id="cuVat" value="${esc(x.vat_id)}"></label>
      <label>Adresse<input id="cuAddress" value="${esc(x.address)}"></label>
      <label>Ort<input id="cuCity" value="${esc(x.city)}"></label>
      <label>E-Mail<input id="cuEmail" type="email" value="${esc(x.email)}"></label>
      <label>Telefon<input id="cuPhone" value="${esc(x.phone)}"></label>
    </div>
    <div class="modal-actions"><button class="btn secondary" onclick="closeModal()">Abbrechen</button><button class="btn primary" onclick="saveCustomer('${id||""}')">Speichern</button></div>`);
}
async function saveCustomer(id){
  const body={company:document.getElementById("cuCompany").value.trim(),vat_id:document.getElementById("cuVat").value.trim(),address:document.getElementById("cuAddress").value.trim(),city:document.getElementById("cuCity").value.trim(),email:document.getElementById("cuEmail").value.trim(),phone:document.getElementById("cuPhone").value.trim()};
  if(!body.company)return alert("Firma ist erforderlich.");
  try{await api(id?"/api/customers/manage/"+id:"/api/customers/manage",{method:id?"PATCH":"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});closeModal();await refreshState();loadCustomersManage()}catch(e){alert(e.message)}
}
async function deleteCustomer(id){
  if(!confirm("Kunden wirklich löschen?"))return;
  try{await api("/api/customers/manage/"+id,{method:"DELETE"});await refreshState();loadCustomersManage()}catch(e){alert(e.message)}
}

