async function editTrip(id){
 const t=S.trips.find(x=>x.id===id)||{};
 modal(`<h2>Auftrag bearbeiten</h2><div class="form form-2">
 <label>Gewicht (KG)<input id="etWeight" type="number" min="0" max="1000" value="${esc(t.weight_kg||0)}"></label>
 <label>Netto-Preis (€)<input id="etPrice" type="number" min="0" step="0.01" value="${esc(t.price_net||0)}"></label>
 <label>Stückzahl<input id="etPieces" type="number" min="1" value="${esc(t.pieces||1)}"></label>
 <label>Route<input id="etRoute" value="${esc(t.route||"")}"></label>
 </div><div class="modal-actions"><button class="btn secondary" onclick="closeModal()">Abbrechen</button><button class="btn primary" onclick="saveTripEdit('${id}')">Speichern</button></div>`);
}
async function saveTripEdit(id){
 const weight=Number(document.getElementById("etWeight").value||0),price=Number(document.getElementById("etPrice").value||0);
 if(weight>1000)return alert("Maximal 1.000 KG");if(price<0)return alert("Preis darf nicht negativ sein");
 try{await api("/api/trips/"+id,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify({weight_kg:weight,price_net:price,pieces:Number(document.getElementById("etPieces").value||1),route:document.getElementById("etRoute").value})});closeModal();await refreshState();view("dispatch")}catch(e){alert(e.message)}
}
async function loadCustomer360(id){
 const box=document.getElementById("customer360Box");if(!box)return;
 try{const d=await api("/api/customers/"+id+"/360");box.innerHTML=`<div class="grid">
 <div class="stat"><span>Rechnungsvolumen</span><b>€ ${Number(d.totals.total_billed||0).toFixed(2)}</b></div>
 <div class="stat"><span>Offen</span><b>€ ${Number(d.totals.outstanding||0).toFixed(2)}</b></div>
 <div class="stat"><span>Aufträge</span><b>${d.orders.length}</b></div><div class="stat"><span>DDT</span><b>${d.ddts.length}</b></div></div>
 <div class="panel"><h3>Stammdaten</h3><p><b>${esc(d.customer.company)}</b><br>${esc(d.customer.address||"")} · ${esc(d.customer.city||"")}<br>${esc(d.customer.email||"")} · ${esc(d.customer.phone||"")}</p></div>
 <div class="panel"><h3>Rechnungen</h3>${d.invoices.map(i=>`<div class="listRow"><span>${i.invoice_number} · € ${Number(i.gross).toFixed(2)} · ${i.status}</span><button class="btn secondary" onclick="previewPdf('invoice','${i.id}')">Vorschau</button><button class="btn secondary" onclick="inv('${i.id}')">PDF</button></div>`).join("")||"<p class='muted'>Keine Rechnungen.</p>"}</div>
 <div class="panel"><h3>Lieferscheine / Lieferungen</h3>${d.ddts.map(x=>`<div class="listRow"><span>${x.document_number} · ${x.trip_number}</span><button class="btn secondary" onclick="previewPdf('ddt','${x.trip_id}')">Vorschau</button><button class="btn secondary" onclick="ddt('${x.trip_id}')">PDF</button></div>`).join("")||"<p class='muted'>Keine DDT.</p>"}</div>
`}catch(e){box.innerHTML=`<div class="error">${esc(e.message)}</div>`}
}
</script>
<script>
/* V11 mobile helpers: local offline action queue + installable PWA */
const ED_QUEUE_KEY="ed_v11_queue";
function edQueue(){return JSON.parse(localStorage.getItem(ED_QUEUE_KEY)||"[]")}
function edEnqueue(action){
  const q=edQueue(); q.push({...action,id:(crypto.randomUUID?crypto.randomUUID():String(Date.now()+Math.random()))});
  localStorage.setItem(ED_QUEUE_KEY,JSON.stringify(q));
}
async function edSync(){
  if(!navigator.onLine) return;
  const q=edQueue(); if(!q.length || !window.T) return;
  try{
    const r=await fetch("/api/sync",{method:"POST",headers:{"Content-Type":"application/json","Authorization":"Bearer "+window.T},
      body:JSON.stringify({actions:q})});
    if(r.ok){
      const out=await r.json();
      const done=new Set((out.results||[]).filter(x=>x.ok).map(x=>x.id));
      localStorage.setItem(ED_QUEUE_KEY,JSON.stringify(q.filter(x=>!done.has(x.id))));
    }
  }catch(e){}
}
window.addEventListener("online",edSync);
setInterval(edSync,10000);
if("serviceWorker" in navigator){navigator.serviceWorker.register("/sw.js").catch(()=>{});}
</script>

<script>
/* V194: bearbeitbarer Auftrag 360 + Operations Board; Audit-Oberfläche entfernt */
async function renderOrder360(){
  const c=document.getElementById("c");
  c.innerHTML='<div class="page-head"><div><div class="eyebrow">AUFTRAG</div><h2>Auftrag 360°</h2><p class="muted">Auftrag, Kunde, Disposition, Stopps und Rechnungen zentral bearbeiten.</p></div><select id="order360Select" onchange="loadOrder360(this.value)"><option>Aufträge werden geladen…</option></select></div><div id="order360Box"><div class="panel"><p class="muted">Lade Aufträge…</p></div></div>';
  try{
    const orders=await api("/api/orders");
    const sel=document.getElementById("order360Select");
    sel.innerHTML=orders.map(o=>'<option value="'+o.id+'">'+esc(o.reference||o.order_number||("Auftrag "+o.id))+' · '+esc(o.customer_name||o.customer_company||"")+'</option>').join("")||'<option value="">Keine Aufträge</option>';
    if(orders[0]) await loadOrder360(orders[0].id);
  }catch(e){document.getElementById("order360Box").innerHTML='<div class="panel"><p class="error">'+esc(e.message)+'</p></div>'}
}
async function loadOrder360(id){
  if(!id)return;
  const box=document.getElementById("order360Box");
  box.innerHTML='<div class="panel"><p class="muted">Auftrag wird geladen…</p></div>';
  try{
    const d=await api("/api/orders/"+id+"/360"), customers=await api("/api/customers"), o=d.order||{}, t=d.trip, stops=d.stops||[];
    const customerOptions=customers.map(x=>'<option value="'+x.id+'" '+(String(x.id)===String(o.customer_id)?'selected':'')+'>'+esc(x.company)+'</option>').join("");
    const statusOptions=["new","planned","in_progress","delivered","cancelled"].map(x=>'<option value="'+x+'" '+(x===o.status?'selected':'')+'>'+x+'</option>').join("");
    const priorityOptions=["normal","high","urgent"].map(x=>'<option value="'+x+'" '+(x===o.priority?'selected':'')+'>'+x+'</option>').join("");
    const stopHtml=stops.map((s,i)=>'<div class="listRow"><div><b>'+(i+1)+'. '+esc(s.customer_name||"Stop")+'</b><div class="muted">'+esc(s.address||"")+'</div></div><div class="row"><select id="o360StopStatus-'+s.id+'">'+["Pending","Arrived","Delivered","Cancelled"].map(x=>'<option value="'+x+'" '+(x===s.status?'selected':'')+'>'+x+'</option>').join("")+'</select><input id="o360StopAddress-'+s.id+'" value="'+esc(s.address||"")+'" style="min-width:260px"><button class="btn secondary" onclick="saveOrder360Stop(\''+s.id+'\')">Speichern</button></div></div>').join("")||'<p class="muted">Keine Stopps vorhanden.</p>';
    const invoiceHtml=(d.invoices||[]).map(i=>'<div class="listRow"><span><b>'+esc(i.invoice_number)+'</b> · '+esc(i.status||"")+' · '+(i.issue_date?String(i.issue_date).slice(0,10):"")+'</span><strong>€ '+Number(i.gross||0).toFixed(2)+'</strong></div>').join("")||'<p class="muted">Keine Rechnungen.</p>';
    box.innerHTML='<div class="grid"><div class="panel"><h3>Auftragsdaten</h3><div class="form form-2">'+
      '<label>Referenz<input id="o360Reference" value="'+esc(o.reference||o.order_number||"")+'"></label>'+
      '<label>Kunde<select id="o360Customer">'+customerOptions+'</select></label>'+
      '<label>Status<select id="o360Status">'+statusOptions+'</select></label>'+
      '<label>Priorität<select id="o360Priority">'+priorityOptions+'</select></label>'+
      '<label>Gewicht KG<input id="o360Kg" type="number" min="0" max="1000" value="'+Number(o.weight_kg||0)+'"></label>'+
      '<label>Stück<input id="o360Pieces" type="number" min="1" value="'+Number(o.pieces||1)+'"></label>'+
      '<label>Netto EUR<input id="o360Price" type="number" step="0.01" value="'+Number(o.price_net||0).toFixed(2)+'"></label>'+
      '<label>Geplanter Tag<input id="o360Date" type="date" value="'+(o.requested_date?String(o.requested_date).slice(0,10):"")+'"></label>'+
      '<label>Abholadresse<input id="o360Pickup" value="'+esc(o.pickup_address||"")+'"></label>'+
      '<label>Abholort<input id="o360PickupCity" value="'+esc(o.pickup_city||"")+'"></label>'+
      '<label>Lieferadresse<input id="o360Delivery" value="'+esc(o.delivery_address||"")+'"></label>'+
      '<label>Lieferort<input id="o360DeliveryCity" value="'+esc(o.delivery_city||"")+'"></label>'+
      '<label>Kundenreferenz<input id="o360CustomerRef" value="'+esc(o.customer_reference||"")+'"></label>'+
      '<label>Dispo-Notiz<input id="o360Note" value="'+esc(o.dispatch_note||"")+'"></label></div>'+
      '<div class="modal-actions" style="margin-top:16px"><button class="btn primary" onclick="saveOrder360(\''+o.id+'\')">Auftrag speichern</button></div></div>'+
      '<div class="panel"><h3>Kunde</h3><p><b>'+esc(o.customer_company||"-")+'</b></p><p class="muted">'+esc(o.customer_address||"")+'<br>'+esc(o.customer_city||"")+'<br>'+esc(o.customer_email||"")+'<br>'+esc(o.customer_phone||"")+'</p><h3>Disposition</h3><p>'+(t?'<b>'+esc(t.trip_number||"")+'</b><br>'+esc(t.driver_name||"Kein Fahrer")+' · '+esc(t.vehicle_name||"Kein Fahrzeug")+'<br>'+Number(t.weight_kg||0)+' KG · '+esc(t.status||""):"Noch keiner Tour zugeordnet.")+'</p></div></div>'+
      '<div class="panel"><h3>Stopps</h3>'+stopHtml+'</div>'+
      '<div class="panel"><h3>Rechnungen des Kunden</h3>'+invoiceHtml+'</div>';
  }catch(e){box.innerHTML='<div class="panel"><p class="error">'+esc(e.message)+'</p></div>'}
}
async function saveOrder360(id){
  const kg=Number(document.getElementById("o360Kg").value||0); if(kg>1000)return alert("Maximal 1.000 KG");
  const body={reference:document.getElementById("o360Reference").value.trim(),customer_id:document.getElementById("o360Customer").value,pickup_address:document.getElementById("o360Pickup").value.trim(),pickup_city:document.getElementById("o360PickupCity").value.trim(),delivery_address:document.getElementById("o360Delivery").value.trim(),delivery_city:document.getElementById("o360DeliveryCity").value.trim(),weight_kg:kg,pieces:Number(document.getElementById("o360Pieces").value||1),customer_reference:document.getElementById("o360CustomerRef").value.trim(),priority:document.getElementById("o360Priority").value,requested_date:document.getElementById("o360Date").value||null,price_net:Number(document.getElementById("o360Price").value||0),status:document.getElementById("o360Status").value,dispatch_note:document.getElementById("o360Note").value.trim()};
  try{await api("/api/orders/"+id,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});alert("Auftrag gespeichert.");await loadOrder360(id)}catch(e){alert(e.message)}
}
async function saveOrder360Stop(id){
  try{await api("/api/planning/stops/"+id,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify({address:document.getElementById("o360StopAddress-"+id).value.trim()})});await api("/api/stops/"+id,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify({status:document.getElementById("o360StopStatus-"+id).value})});await loadOrder360(document.getElementById("order360Select").value);alert("Stopp gespeichert.")}catch(e){alert(e.message)}
}
function renderOperationsBoard(){
  const c=document.getElementById("c"),today=new Date().toISOString().slice(0,10);
  c.innerHTML='<div class="page-head"><div><div class="eyebrow">STEUERUNG</div><h2>Operations Board</h2><p class="muted">Touren, Kapazität, Fahrer, Fahrzeuge und Stopps direkt bearbeiten.</p></div><label>Planungstag<input id="opsDate" type="date" value="'+today+'" onchange="loadOperationsBoard(this.value)"></label></div><div id="operationsBox"><div class="panel"><p class="muted">Board wird geladen…</p></div></div>';
  loadOperationsBoard(today);
}
async function loadOperationsBoard(date){
  const box=document.getElementById("operationsBox");if(!box)return;
  try{
    const d=await api("/api/dispatch/board?date="+encodeURIComponent(date));
    const trips=(d.trips||[]).map(t=>{
      const stops=(d.stops||[]).filter(s=>String(s.trip_id)===String(t.id)).map(s=>'<div class="listRow"><div><b>'+Number(s.stop_order||1)+'. '+esc(s.customer_name||"Stop")+'</b><div class="muted">'+esc(s.address||"")+'</div></div><div class="row"><select id="opStopStatus-'+s.id+'">'+["Pending","Arrived","Delivered","Cancelled"].map(x=>'<option value="'+x+'" '+(x===s.status?'selected':'')+'>'+x+'</option>').join("")+'</select><input id="opStopAddress-'+s.id+'" value="'+esc(s.address||"")+'" style="min-width:220px"><button class="btn secondary" onclick="saveOperationsStop(\''+s.id+'\')">Speichern</button></div></div>').join("")||'<p class="muted">Keine Stopps.</p>';
      return '<div class="panel"><div class="page-head"><div><h3>'+esc(t.trip_number||"Tour")+'</h3><p class="muted">'+Number(t.weight_kg||0).toFixed(0)+' / 1.000 KG · '+esc(t.status||"")+'</p></div></div><div class="form form-2">'+
        '<label>Status<select id="opStatus-'+t.id+'">'+["Planned","In Transit","Delivered","Cancelled"].map(x=>'<option value="'+x+'" '+(x===t.status?'selected':'')+'>'+x+'</option>').join("")+'</select></label>'+
        '<label>Priorität<select id="opPriority-'+t.id+'">'+["normal","high","urgent"].map(x=>'<option value="'+x+'" '+(x===t.priority?'selected':'')+'>'+x+'</option>').join("")+'</select></label>'+
        '<label>Fahrer<select id="opDriver-'+t.id+'"><option value="">Kein Fahrer</option>'+S.users.filter(x=>x.role==="Driver").map(x=>'<option value="'+x.id+'" '+(String(x.id)===String(t.driver_id)?'selected':'')+'>'+esc(x.name)+'</option>').join("")+'</select></label>'+
        '<label>Fahrzeug<select id="opVehicle-'+t.id+'"><option value="">Kein Fahrzeug</option>'+S.vehicles.map(x=>'<option value="'+x.id+'" '+(String(x.id)===String(t.vehicle_id)?'selected':'')+'>'+esc(x.name)+' · '+esc(x.plate)+'</option>').join("")+'</select></label>'+
        '<label>Start<input id="opStart-'+t.id+'" type="datetime-local" value="'+(t.planned_start_at?String(t.planned_start_at).slice(0,16):"")+'"></label>'+
        '<label>Notiz<input id="opNote-'+t.id+'" value="'+esc(t.dispatcher_note||t.board_note||"")+'"></label></div><div class="modal-actions" style="margin-top:12px"><button class="btn primary" onclick="saveOperationsTrip(\''+t.id+'\')">Tour speichern</button></div><h4>Stopps</h4>'+stops+'</div>';
    }).join("")||'<div class="panel"><p class="muted">Keine Touren für diesen Tag.</p></div>';
    const openOrders=(d.orders||[]).map(o=>'<div class="listRow"><div><b>'+esc(o.reference||o.order_number||"Auftrag")+'</b><div class="muted">'+esc(o.customer_company||"")+' · '+Number(o.weight_kg||0)+' KG · '+esc(o.priority||"normal")+'</div></div><div class="row"><select id="assign-'+o.id+'"><option value="">Tour auswählen</option>'+d.trips.map(t=>'<option value="'+t.id+'">'+esc(t.trip_number)+'</option>').join("")+'</select><button class="btn secondary" onclick="assignBoardOrder(\''+o.id+'\')">Zuweisen</button></div></div>').join("")||'<p class="muted">Keine offenen Aufträge.</p>';
    box.innerHTML='<div class="grid">'+trips+'</div><div class="panel"><h3>Offene Aufträge</h3>'+openOrders+'</div>';
  }catch(e){box.innerHTML='<div class="panel"><p class="error">'+esc(e.message)+'</p></div>'}
}
async function saveOperationsTrip(id){
  const body={driver_id:document.getElementById("opDriver-"+id).value||null,vehicle_id:document.getElementById("opVehicle-"+id).value||null,status:document.getElementById("opStatus-"+id).value,priority:document.getElementById("opPriority-"+id).value,planned_start_at:document.getElementById("opStart-"+id).value||null,dispatcher_note:document.getElementById("opNote-"+id).value.trim()};
  try{await api("/api/planning/trips/"+id,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});alert("Tour gespeichert.");loadOperationsBoard(document.getElementById("opsDate").value)}catch(e){alert(e.message)}
}
async function saveOperationsStop(id){
  try{await api("/api/planning/stops/"+id,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify({address:document.getElementById("opStopAddress-"+id).value.trim()})});await api("/api/stops/"+id,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify({status:document.getElementById("opStopStatus-"+id).value})});alert("Stopp gespeichert.");loadOperationsBoard(document.getElementById("opsDate").value)}catch(e){alert(e.message)}
}
async function assignBoardOrder(id){
  const target=document.getElementById("assign-"+id).value;if(!target)return alert("Bitte Tour auswählen.");
  try{await api("/api/dispatch/move-order",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({order_id:id,target_trip_id:target,position:999})});alert("Auftrag zugewiesen.");loadOperationsBoard(document.getElementById("opsDate").value)}catch(e){alert(e.message)}
}
</script>
</body></html>
